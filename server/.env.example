DATABASE_URL=postgresql://smsgateway:smsgateway@localhost:5432/smsgateway
ADMIN_SECRET=dev-only-admin-secret-change-this
CRON_SECRET=dev-only-cron-secret-change-this
API_RATE_LIMIT_PER_MIN=60
MESSAGE_TTL_SECONDS=300
JOB_CLAIM_TTL_SECONDS=120
HEARTBEAT_TTL_SECONDS=90
REGISTRATION_TOKEN_TTL_SECONDS=3600
LOG_LEVEL=info
NODE_ENV=development
PORT=3000
